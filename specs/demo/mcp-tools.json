{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "search_documents",
        "title": "Search Documents",
        "description": "Searches approved research documents and returns matching passages with source IDs.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural language research query."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "documentId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "snippet": {
                    "type": "string"
                  },
                  "sourceUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "documentId",
                  "snippet"
                ]
              }
            }
          },
          "required": [
            "results"
          ]
        }
      },
      {
        "name": "fetch_document",
        "title": "Fetch Document",
        "description": "Retrieves metadata and approved excerpts for a single document ID.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "documentId": {
              "type": "string"
            }
          },
          "required": [
            "documentId"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "documentId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "excerpts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "documentId",
            "title",
            "excerpts"
          ]
        }
      }
    ]
  }
}
