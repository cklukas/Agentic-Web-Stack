{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-web-stack.example/schemas/a2a-message-send.schema.json",
  "title": "Agentic Web Stack Demo A2A Message Send",
  "description": "Non-normative project schema for validating the demo A2A JSON-RPC message/send request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "method", "params"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["integer", "string"] },
    "method": { "const": "message/send" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "configuration", "metadata"],
      "properties": {
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["messageId", "role", "parts"],
          "properties": {
            "messageId": { "type": "string", "minLength": 1 },
            "role": { "enum": ["user", "agent"] },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "text"],
                "properties": {
                  "kind": { "const": "text" },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptedOutputModes", "blocking"],
          "properties": {
            "acceptedOutputModes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "blocking": { "type": "boolean" }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "required": ["scenario", "requestedBy", "traceId"]
        }
      }
    }
  }
}
