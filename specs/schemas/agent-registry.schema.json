{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-web-stack.example/schemas/agent-registry.schema.json",
  "title": "Agentic Web Stack Demo Agent Registry",
  "description": "Non-normative project schema for validating the demo agent registry example.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry", "agents"],
  "properties": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "steward"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "steward": { "type": "string", "minLength": 1 }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "approvedDomain",
          "agentCardUrl",
          "currentAgentCardVersion",
          "trustLevel",
          "allowedProtocols",
          "endpoints",
          "requiredScopes",
          "policy",
          "review"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "approvedDomain": { "type": "string", "minLength": 1 },
          "agentCardUrl": { "type": "string", "format": "uri" },
          "currentAgentCardVersion": { "type": "string", "minLength": 1 },
          "trustLevel": {
            "enum": ["public", "verified", "organization-approved", "restricted"]
          },
          "allowedProtocols": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["openapi", "mcp", "a2a"] }
          },
          "endpoints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["openapi", "mcp", "a2a"],
            "properties": {
              "openapi": { "type": "string", "format": "uri" },
              "mcp": { "type": "string", "format": "uri" },
              "a2a": { "type": "string", "format": "uri" }
            }
          },
          "requiredScopes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["humanReviewRequired", "traceRequired", "tokenLoggingAllowed", "dataVisibility"],
            "properties": {
              "humanReviewRequired": { "type": "boolean" },
              "traceRequired": { "type": "boolean" },
              "tokenLoggingAllowed": { "type": "boolean" },
              "dataVisibility": { "type": "string", "minLength": 1 }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reviewedBy", "reviewedAt", "expiresAt"],
            "properties": {
              "status": { "enum": ["approved", "pending", "expired", "rejected"] },
              "reviewedBy": { "type": "string", "minLength": 1 },
              "reviewedAt": { "type": "string", "format": "date" },
              "expiresAt": { "type": "string", "format": "date" }
            }
          }
        }
      }
    }
  }
}
