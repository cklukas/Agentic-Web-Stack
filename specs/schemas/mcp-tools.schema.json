{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-web-stack.example/schemas/mcp-tools.schema.json",
  "title": "Agentic Web Stack Demo MCP Tools List",
  "description": "Non-normative project schema for validating the demo MCP tools/list response.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["integer", "string"] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "title", "description", "inputSchema"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "inputSchema": { "$ref": "https://json-schema.org/draft/2020-12/schema" },
              "outputSchema": { "$ref": "https://json-schema.org/draft/2020-12/schema" }
            }
          }
        }
      }
    }
  }
}
