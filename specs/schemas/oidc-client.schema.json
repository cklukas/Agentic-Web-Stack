{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-web-stack.example/schemas/oidc-client.schema.json",
  "title": "Agentic Web Stack Demo OIDC Client",
  "description": "Non-normative project schema for validating the demo OIDC/OAuth2 client configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identityProvider", "client", "resourceServer", "scopes", "exampleAccessTokenClaims", "tokenHandling"],
  "properties": {
    "identityProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "discoveryUrl"],
      "properties": {
        "issuer": { "type": "string", "format": "uri" },
        "discoveryUrl": { "type": "string", "format": "uri" }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "name", "grantType", "redirectUris"],
      "properties": {
        "clientId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "grantType": { "enum": ["authorization_code"] },
        "redirectUris": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "resourceServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "requiredClaims"],
      "properties": {
        "audience": { "type": "string", "format": "uri" },
        "requiredClaims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scopes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "exampleAccessTokenClaims": {
      "type": "object",
      "additionalProperties": true,
      "required": ["iss", "aud", "sub", "azp", "scope", "tenant"]
    },
    "tokenHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeRefreshTokens", "logTokens", "rotateRefreshTokens", "audienceRestricted"],
      "properties": {
        "storeRefreshTokens": { "type": "boolean" },
        "logTokens": { "type": "boolean" },
        "rotateRefreshTokens": { "type": "boolean" },
        "audienceRestricted": { "type": "boolean" }
      }
    }
  }
}
